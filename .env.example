# TechFlow Environment Variables Template
NODE_ENV="production"
PORT=3000

# Public URLs
NEXTAUTH_URL="https://techflow.digital"
APP_URL="https://techflow.digital"

# NextAuth Secret (random 32+ characters)
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# PostgreSQL Database (Neon pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/techflow?schema=public&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/techflow?schema=public&sslmode=require"

# Neon Branch Config
NEON_BRANCH="production"
NEON_BRANCH_ID="br-patient-credit-aoyumnju"
NEON_FUNCTION_HOST_SUFFIX=".compute.c-2.ap-southeast-1.aws.neon.tech"

# Google OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend Email Configuration
RESEND_API_KEY=""
EMAIL_FROM="TechFlow <notifications@example.com>"

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cron & Demonstration Password
CRON_SECRET="replace-with-another-random-secret"
SEED_DEMO_PASSWORD="DemoPassword123!"
