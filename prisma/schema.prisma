generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  SUPER_ADMIN
  DEPARTMENT_ADMIN
  FIELD_WORKER
}
enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
  REOPENED
}
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum ImageKind {
  COMPLAINT
  PROGRESS
  COMPLETION
}
enum AssignmentStatus {
  ACTIVE
  COMPLETED
  REASSIGNED
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          Role      @default(CITIZEN)
  phone         String?
  isActive      Boolean   @default(true) @map("is_active")
  sessionVersion Int      @default(0) @map("session_version")
  departmentId  String?   @map("department_id") @db.Uuid
  department    Department? @relation(fields: [departmentId], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  complaints    Complaint[] @relation("CitizenComplaints")
  assignments   Assignment[] @relation("WorkerAssignments")
  assignedBy    Assignment[] @relation("AssignedBy")
  history       StatusHistory[]
  images        ComplaintImage[]
  notifications Notification[]
  supports      ComplaintSupport[]
  feedback      Feedback[]
  auditLogs     AuditLog[]
  resetTokens   PasswordResetToken[]
  accounts      Account[]
  sessions      Session[]
  @@index([role, departmentId])
  @@map("users")
}

model Department {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique
  slug        String @unique
  description String?
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  users       User[]
  categories  Category[]
  complaints  Complaint[]
  policies    SlaPolicy[]
  @@map("departments")
}

model Category {
  id           String @id @default(uuid()) @db.Uuid
  name         String @unique
  slug         String @unique
  departmentId String @map("department_id") @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])
  isActive     Boolean @default(true) @map("is_active")
  complaints   Complaint[]
  @@index([departmentId])
  @@map("categories")
}

model Complaint {
  id           String @id @default(uuid()) @db.Uuid
  ticketNumber String @unique @map("ticket_number")
  title        String
  description  String @db.Text
  address      String
  latitude     Float
  longitude    Float
  status       ComplaintStatus @default(SUBMITTED)
  priority     Priority @default(MEDIUM)
  citizenId    String @map("citizen_id") @db.Uuid
  citizen      User @relation("CitizenComplaints", fields: [citizenId], references: [id])
  categoryId   String @map("category_id") @db.Uuid
  category     Category @relation(fields: [categoryId], references: [id])
  departmentId String @map("department_id") @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])
  dueAt        DateTime? @map("due_at")
  resolvedAt   DateTime? @map("resolved_at")
  resolutionApprovedAt DateTime? @map("resolution_approved_at")
  closedAt     DateTime? @map("closed_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  images       ComplaintImage[]
  assignments  Assignment[]
  history      StatusHistory[]
  feedback     Feedback?
  supports     ComplaintSupport[]
  @@index([status, createdAt])
  @@index([citizenId, createdAt])
  @@index([departmentId, status])
  @@index([categoryId, createdAt])
  @@map("complaints")
}

model ComplaintImage {
  id          String @id @default(uuid()) @db.Uuid
  complaintId String @map("complaint_id") @db.Uuid
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  publicId    String @unique @map("public_id")
  secureUrl   String @map("secure_url")
  kind        ImageKind
  uploadedById String @map("uploaded_by_id") @db.Uuid
  uploadedBy  User @relation(fields: [uploadedById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([complaintId, kind])
  @@map("complaint_images")
}

model Assignment {
  id          String @id @default(uuid()) @db.Uuid
  complaintId String @map("complaint_id") @db.Uuid
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  workerId    String @map("worker_id") @db.Uuid
  worker      User @relation("WorkerAssignments", fields: [workerId], references: [id])
  assignedById String @map("assigned_by_id") @db.Uuid
  assignedBy  User @relation("AssignedBy", fields: [assignedById], references: [id])
  status      AssignmentStatus @default(ACTIVE)
  acceptedAt  DateTime? @map("accepted_at")
  completedAt DateTime? @map("completed_at")
  remarks     String? @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([workerId, status])
  @@index([complaintId, createdAt])
  @@map("assignments")
}

model StatusHistory {
  id          String @id @default(uuid()) @db.Uuid
  complaintId String @map("complaint_id") @db.Uuid
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  fromStatus  ComplaintStatus? @map("from_status")
  toStatus    ComplaintStatus @map("to_status")
  actorId     String @map("actor_id") @db.Uuid
  actor       User @relation(fields: [actorId], references: [id])
  remarks     String? @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([complaintId, createdAt])
  @@map("status_history")
}

model Feedback {
  id          String @id @default(uuid()) @db.Uuid
  complaintId String @unique @map("complaint_id") @db.Uuid
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  citizenId   String @map("citizen_id") @db.Uuid
  citizen     User @relation(fields: [citizenId], references: [id])
  rating      Int
  comment     String? @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@map("feedback")
}

model ComplaintSupport {
  id          String @id @default(uuid()) @db.Uuid
  complaintId String @map("complaint_id") @db.Uuid
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  citizenId   String @map("citizen_id") @db.Uuid
  citizen     User @relation(fields: [citizenId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  @@unique([complaintId, citizenId])
  @@map("complaint_supports")
}

model Notification {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  user        User @relation(fields: [userId], references: [id])
  title       String
  body        String
  href        String?
  eventKey    String? @unique @map("event_key")
  readAt      DateTime? @map("read_at")
  emailSentAt DateTime? @map("email_sent_at")
  emailAttempts Int @default(0) @map("email_attempts")
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String @id @default(uuid()) @db.Uuid
  actorId    String? @map("actor_id") @db.Uuid
  actor      User? @relation(fields: [actorId], references: [id])
  action     String
  entityType String @map("entity_type")
  entityId   String @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SlaPolicy {
  id           String @id @default(uuid()) @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])
  priority     Priority
  hours        Int
  isActive     Boolean @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@unique([departmentId, priority])
  @@map("sla_policies")
}

model PasswordResetToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Account {
  id                String @id @default(uuid()) @db.Uuid
  userId            String @map("user_id") @db.Uuid
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String @id @default(uuid()) @db.Uuid
  sessionToken String @unique @map("session_token")
  userId       String @map("user_id") @db.Uuid
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime
  @@unique([identifier, token])
  @@map("verification_tokens")
}

model RateLimitEvent {
  id        String @id @default(uuid()) @db.Uuid
  key       String
  createdAt DateTime @default(now()) @map("created_at")
  @@index([key, createdAt])
  @@map("rate_limit_events")
}
